# Configurações do Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
# Utilize a chave service_role no servidor
SUPABASE_KEY=sua_chave_service_role_aqui

# Ambiente e Porta
NODE_ENV=production
PORT=3001

# Chave Criptográfica Mestra AES-256 (32 bytes / 64 hexadecimais)
ENCRYPTION_KEY=gere_sua_chave_de_64_hex_aqui

# Token de Autenticação do Webhook do Asaas (configurado no painel do Asaas)
ASAAS_WEBHOOK_TOKEN=seu_token_secreto_asaas_aqui
