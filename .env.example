# Configurações do Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
# Utilize a chave service_role no servidor
SUPABASE_KEY=sua_chave_service_role_aqui

# Chave de Criptografia Simétrica para senhas de certificados (exatamente 32 caracteres)
ENCRYPTION_KEY=coloque_sua_chave_de_32_chars_aqui

# Porta do Servidor Web
PORT=3001
